{
  "info": {
    "_postman_id": "b035709c-3c45-4fdc-bbf2-e460d86aa241",
    "name": "Atelier Store API",
    "description": "Local API requests for the Atelier storefront. Register or log in as a customer for customer endpoints. Administrator endpoints require an administrator token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "cartItemId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "categoryId", "value": "1" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Avery Smith\",\n  \"email\": \"avery@example.test\",\n  \"password\": \"correct-horse-battery\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().token);"] } }]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"avery@example.test\",\n  \"password\": \"correct-horse-battery\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().token);"] } }]
        },
        {
          "name": "Current customer",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Login local administrator",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }]
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Search products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page=0&size=12&sortBy=price&direction=asc&search=&categoryId=&minPrice=&maxPrice=",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "12" },
                { "key": "sortBy", "value": "price" },
                { "key": "direction", "value": "asc" },
                { "key": "search", "value": "" },
                { "key": "categoryId", "value": "" },
                { "key": "minPrice", "value": "" },
                { "key": "maxPrice", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Product details",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }
        },
        {
          "name": "List categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories" }
        },
        {
          "name": "Category details",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories/{{categoryId}}" }
        }
      ]
    },
    {
      "name": "Customer cart and orders",
      "item": [
        {
          "name": "Get cart",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/cart"
          }
        },
        {
          "name": "Add cart item",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/cart/items"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200 && pm.response.json().items.length) pm.collectionVariables.set('cartItemId', pm.response.json().items[0].id);"] } }]
        },
        {
          "name": "Update cart item quantity",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{baseUrl}}/cart/items/{{cartItemId}}"
          }
        },
        {
          "name": "Checkout persistent cart",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"address\": \"12 Market Street, Portland, OR 97201\"\n}" },
            "url": "{{baseUrl}}/orders/checkout"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('orderId', pm.response.json().id);"] } }]
        },
        {
          "name": "Order history",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Order details",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Administrator",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "Create category",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Studio Objects\",\n  \"description\": \"Objects made in the studio\"\n}" },
            "url": "{{baseUrl}}/admin/categories"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) pm.collectionVariables.set('categoryId', pm.response.json().id);"] } }]
        },
        {
          "name": "Create product",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test object\",\n  \"category\": \"Studio Objects\",\n  \"description\": \"A sample item for local API testing.\",\n  \"price\": 25.00,\n  \"image\": \"\",\n  \"stock\": 5\n}" },
            "url": "{{baseUrl}}/admin/products"
          }
        },
        {
          "name": "Update category",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Studio Objects\",\n  \"description\": \"Updated category description\"\n}" },
            "url": "{{baseUrl}}/admin/categories/{{categoryId}}"
          }
        },
        {
          "name": "All orders",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/admin/orders"
          }
        },
        {
          "name": "Update order status",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "adminToken", "value": "{{adminToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"shipped\"\n}" },
            "url": "{{baseUrl}}/admin/orders/{{orderId}}/status"
          }
        }
      ]
    }
  ]
}
